# EMTAF image configuration
# LOCAL: images are built directly into the local Docker engine and used by
# Docker Desktop Kubernetes. No registry login is required.
EMTAF_IMAGE_MODE=local
EMTAF_REGISTRY=
EMTAF_IMAGE_TAG=dev
EMTAF_IMAGE_PULL_POLICY=IfNotPresent

# CLOUD example:
# EMTAF_IMAGE_MODE=cloud
# EMTAF_REGISTRY=ghcr.io/your-org
# EMTAF_IMAGE_TAG=1.8.0
# EMTAF_IMAGE_PULL_POLICY=IfNotPresent
